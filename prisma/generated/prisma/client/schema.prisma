generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  firstName              String
  middleName             String?
  lastName               String
  gender                 String
  dob                    String
  residenceCounty        String
  residenceLocation      String?
  constituency           String?
  residenceConstituency  String?
  email                  String?                 @unique
  phoneNumber            String                  @unique
  nationalId             String?                 @unique
  businessNumber         String?
  pin                    String
  yearsOfExperience      Int?
  otp                    String?
  otpExpiry              DateTime?
  isVerified             Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  farms                  Farm[]
  feedingPrograms        FeedingProgram[]
  allergyRecords         AllergyRecord[]
  boosterRecords         BoosterRecord[]
  vaccinationRecords     VaccinationRecord[]
  dewormingRecords       DewormingRecord[]
  geneticDisorderRecords GeneticDisorderRecord[]
  treatmentRecords       TreatmentRecord[]
}

model Farm {
  id                     String                  @id @default(cuid())
  name                   String
  county                 String
  administrativeLocation String
  size                   Float
  ownership              String
  farmingTypes           String[]
  userId                 String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  employees              EmployeeFarm[]
  livestock              Livestock[]
  breedingRecords        BreedingRecord[]
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedingPrograms        FeedingProgram[]
  inventories            Inventory[]
  allergyRecords         AllergyRecord[]
  boosterRecords         BoosterRecord[]
  vaccinationRecords     VaccinationRecord[]
  dewormingRecords       DewormingRecord[]
  geneticDisorderRecords GeneticDisorderRecord[]
  treatmentRecords       TreatmentRecord[]
  saleListings           SaleListing[]
  cropCycles             CropCycle[]
}

model Employee {
  id               String            @id @default(cuid())
  firstName        String
  middleName       String?
  lastName         String
  phone            String            @unique
  emergencyContact String?
  idNumber         String            @unique
  idPhoto          String?
  employeeType     String
  dateOfEmployment DateTime
  endDate          DateTime?
  role             String
  customRole       String?
  paymentSchedule  String
  salary           Float
  typeOfEngagement String?
  workSchedule     String?
  pin              String?
  otp              String?
  otpExpiry        DateTime?
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  benefits         EmployeeBenefit[]
  farms            EmployeeFarm[]
}

model EmployeeFarm {
  id         String   @id @default(cuid())
  employeeId String
  farmId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([employeeId, farmId])
}

model EmployeeBenefit {
  id         String   @id @default(cuid())
  employeeId String
  name       String
  amount     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, name])
}

model Livestock {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  category  String // mammal or poultry
  type      String // e.g., dairy cow, beef cattle, layer, broiler
  status    String   @default("active") // active, deceased, sold, transferred
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mammal                 Mammal?
  poultry                Poultry?
  mortality              Mortality?
  healthEvent            HealthEvent[]
  transfer               Transfer[]
  sale                   Sale?
  breedingDam            BreedingRecord[]        @relation("dam")
  breedingSire           BreedingRecord[]        @relation("sire")
  offspring              Offspring[]
  allergyRecords         AllergyRecord[]
  boosterRecords         BoosterRecord[]
  vaccinationRecords     VaccinationRecord[]
  dewormingRecords       DewormingRecord[]
  geneticDisorderRecords GeneticDisorderRecord[]
  treatmentRecords       TreatmentRecord[]
}

model Mammal {
  id               String    @id @default(cuid())
  livestockId      String    @unique
  idNumber         String    @unique
  breedType        String
  phenotype        String?
  dateOfBirth      String
  gender           String
  sireId           String?
  sireCode         String?
  damId            String?
  damCode          String?
  birthWeight      Float?
  currentWeight    Float?
  lastWeighingDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  livestock        Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Poultry {
  id                   String    @id @default(cuid())
  livestockId          String    @unique
  flockId              String    @unique
  dateOfStocking       DateTime
  gender               String
  initialQuantity      Int
  currentQuantity      Int
  breedType            String
  sourceOfBirds        String
  initialAverageWeight Float?
  currentAverageWeight Float?
  lastWeighingDate     DateTime?
  mortalityRate        Float?    @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  livestock            Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Mortality {
  id          String    @id @default(cuid())
  livestockId String    @unique
  date        DateTime
  cause       String
  description String?
  reportedBy  String?
  attachments String[] // URLs to photos or documents
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model HealthEvent {
  id            String    @id @default(cuid())
  livestockId   String
  eventType     String // vaccination, treatment, check-up, etc.
  date          DateTime
  description   String
  performedBy   String?
  medications   String[]
  dosage        String?
  cost          Float?
  nextScheduled DateTime?
  attachments   String[] // URLs to photos or documents
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  livestock     Livestock @relation(fields: [livestockId], references: [id])
}

model Transfer {
  id                  String    @id @default(cuid())
  livestockId         String
  fromFarmId          String
  toFarmId            String
  transferDate        DateTime
  reason              String?
  transportMethod     String?
  handlingPrecautions String?
  attachments         String[] // URLs to photos or documents
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  livestock           Livestock @relation(fields: [livestockId], references: [id])
}

model Sale {
  id            String    @id @default(cuid())
  livestockId   String    @unique
  livestock     Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  saleDate      DateTime
  buyerName     String
  buyerContact  String?
  saleAmount    Float
  paymentMethod String
  receiptNumber String?
  notes         String?
  attachments   String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BreedingRecord {
  id            String     @id @default(cuid())
  damId         String
  dam           Livestock  @relation("dam", fields: [damId], references: [id], onDelete: Cascade)
  sireId        String?
  sire          Livestock? @relation("sire", fields: [sireId], references: [id], onDelete: SetNull)
  purpose       String
  strategy      String
  serviceType   String
  serviceDate   DateTime
  numServices   Int        @default(1)
  firstHeatDate DateTime?

  // AI specific fields
  sireCode String? // For AI, the code of the semen used
  aiType   String? // Sex Cell Semen, Regular AI
  aiSource String? // Local, Imported
  aiCost   Float? // Cost of AI service

  // Gestation details
  gestationDays     Int // Expected gestation period in days
  expectedBirthDate DateTime

  // Birth details (if recorded)
  birthRecorded  Boolean   @default(false)
  birthDate      DateTime?
  deliveryMethod String? // Natural Birth, Assisted, Cesarean
  youngOnes      Int? // Number of offspring
  birthWeight    Float? // For single births
  litterWeight   Float? // For multiple births (e.g., swine)
  offspringSex   String? // Description of offspring sex distribution

  // Relations
  offspring Offspring[]

  farmId    String // For easy filtering by farm
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offspring {
  id               String         @id @default(cuid())
  breedingRecordId String
  breedingRecord   BreedingRecord @relation(fields: [breedingRecordId], references: [id], onDelete: Cascade)
  livestockId      String? // If registered as livestock
  livestock        Livestock?     @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  offspringId      String // ID/tag number assigned to the offspring
  sex              String // Male, Female
  birthWeight      Float?
  notes            String?
  status           String         @default("alive") // alive, deceased, sold, transferred
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model FeedingProgram {
  id                   String   @id @default(cuid())
  farmId               String
  userId               String
  programType          String // Single Animal or Group
  animalId             String?
  animalType           String?
  lifecycleStages      String[]
  groupId              String?
  groupType            String?
  groupLifecycleStages String[]
  groupName            String?
  feedType             String // Basal Feeds or Basal Feed + Concentrates + Supplements
  timeOfDay            String[]
  notes                String?
  // Grazing specific
  grazingDuration      String?
  customHours          Float?
  grazingCost          Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  feedDetails FeedDetails[]
}

model FeedDetails {
  id            String   @id @default(cuid())
  feedType      String
  feedName      String?
  source        String
  schedule      String
  quantity      Float
  date          DateTime
  cost          Float?
  supplier      String?
  transportCost Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  feedingProgramId String
  feedingProgram   FeedingProgram @relation(fields: [feedingProgramId], references: [id], onDelete: Cascade)
}

// Inventory

model Inventory {
  id           String         @id @default(cuid())
  farmId       String
  farm         Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  goodsInStock GoodsInStock[]
  machinery    Machinery[]
  utilities    Utility[]
  water        Water[]
  power        Power[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model GoodsInStock {
  id                 String    @id @default(cuid())
  inventoryId        String
  inventory          Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  itemName           String
  batchNumber        String?
  category           String?
  sku                String?
  quantity           Int
  unit               String?
  currentLocation    String
  condition          String
  purchasePrice      Float?
  purchaseDate       DateTime?
  supplier           String?
  expirationDate     DateTime?
  nextInspectionDate DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Machinery {
  id                 String    @id @default(cuid())
  inventoryId        String
  inventory          Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  equipmentName      String
  equipmentId        String?
  purchaseDate       DateTime?
  purchasePrice      Float?
  machineryLocation  String?
  machineryCondition String?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Utility {
  id                  String    @id @default(cuid())
  inventoryId         String
  inventory           Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  structureType       String?
  structureCapacity   String?
  constructionCost    Float?
  facilityCondition   String?
  utilityLocation     String?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  maintenanceCost     Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Water {
  id                      String    @id @default(cuid())
  inventoryId             String
  inventory               Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  waterSource             String?
  waterCapacity           String?
  waterLevel              Float?
  waterConstructionCost   Float?
  waterLocation           String?
  waterEntryDate          DateTime?
  nextInspectionDateWater DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Power {
  id                       String    @id @default(cuid())
  inventoryId              String
  inventory                Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  powerSource              String?
  powerCapacity            String?
  powerInstallationCost    Float?
  powerLocation            String?
  consumptionRate          Float?
  consumptionCost          Float?
  lastMaintenanceDatePower DateTime?
  nextMaintenanceDatePower DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// Health Module
model AllergyRecord {
  id                String    @id @default(cuid())
  animalIdOrFlockId String
  dateRecorded      DateTime
  cause             String
  remedy            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  farmId            String
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  livestockId       String
  livestock         Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model BoosterRecord {
  id                  String    @id @default(cuid())
  animalIdOrFlockId   String
  boostersOrAdditives String
  purpose             String
  quantityGiven       Float
  quantityUnit        String
  dateAdministered    DateTime
  costOfBooster       Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  farmId              String
  farm                Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  livestockId         String
  livestock           Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model VaccinationRecord {
  id                 String    @id @default(cuid())
  animalIdOrFlockId  String
  vaccinationAgainst String
  drugAdministered   String
  dateAdministered   DateTime
  dosage             Float
  costOfVaccine      Float?
  administeredBy     String?
  practiceId         String?
  costOfService      Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  farmId             String
  farm               Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  livestockId        String
  livestock          Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model DewormingRecord {
  id                 String    @id @default(cuid())
  animalIdOrFlockId  String
  dewormingAgainst   String
  drugAdministered   String
  dosage             Float
  dateAdministered   DateTime
  costOfVaccine      Float?
  costOfService      Float?
  administeredByType String // "Veterinary" or "AI Technician"
  administeredByName String?
  practiceId         String? // For Veterinary
  technicianId       String? // For AI Technician
  farmerWitness      String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  farmId             String
  farm               Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  livestockId        String
  livestock          Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model GeneticDisorderRecord {
  id                 String    @id @default(cuid())
  animalIdOrFlockId  String
  dateRecorded       DateTime
  nameOfCondition    String
  remedy             String?
  administeredByType String // "Veterinary" or "AI Technician"
  administeredByName String?
  practiceId         String? // For Veterinary
  technicianId       String? // For AI Technician
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  farmId             String
  farm               Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  livestockId        String
  livestock          Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model TreatmentRecord {
  id                   String    @id @default(cuid())
  animalIdOrFlockId    String
  healthEventDate      DateTime
  healthEventSymptoms  String
  diagnosis            String
  treatmentType        String // Curative, Preventive, Supportive, Behavioral and Alternative
  treatmentDescription String?
  drugAdministered     String?
  dateAdministered     DateTime?
  dosageAdministered   Float?
  costOfDrugs          Float?
  medicalOfficerName   String?
  licenseId            String?
  costOfService        Float?
  farmerWitnessName    String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  farmId               String
  farm                 Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  livestockId          String
  livestock            Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

// Sales Module - Enhanced sales listings for livestock
model SaleListing {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  // Basic Information
  name        String
  category    String // dairyCattle, beefCattle, dairyGoats, meatGoats, sheep, swine, poultry, rabbits
  breed       String
  age         String
  weight      Float
  price       Float
  status      String  @default("available") // available, reserved, sold
  health      String // excellent, good, fair, poor
  lastCheckup String?

  // Identifiers/mapping
  animalId    String?
  livestockId String?

  // Optional fields based on livestock type
  purpose        String? // Milk Production, Meat Production, Breeding, Both
  feedingProgram String?

  // Dairy cattle specific
  milkProduction  String? // e.g., "25 L/day"
  pregnancyStatus String? // e.g., "Not Pregnant", "Pregnant (6 months)"

  // Quality grading
  beefQuality String?
  milkQuality String?

  // Dairy production metrics
  milkYield       Float?
  milkingDate     DateTime?
  homeUseQuantity Float?
  saleQuantity    Float?

  // Poultry specific
  quantity          Int? // Number of birds
  pricePerBird      Float? // Price per individual bird
  eggProductionRate String? // e.g., "85%"

  // Sheep specific
  woolYield String? // e.g., "5.5 kg/year"

  // Goat specific
  milkProductionRate String? // e.g., "3.5 L/day"

  // Additional information
  notes  String?
  images String[] // Array of image URLs

  // Sale completion details (when status becomes 'sold')
  saleDate      DateTime?
  buyerName     String?
  buyerContact  String?
  buyerType     String?
  saleAmount    Float? // Final sale amount (might differ from listing price)
  marketPrice   Float?
  salePrice     Float?
  paymentMethod String?
  receiptNumber String?
  saleNotes     String?
  attachments   String[] // Sale-related attachments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// CROPS MODULE
// ─────────────────────────────────────────────────────────────────────────────

model CropCycle {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name          String
  startDate     String
  endDate       String?
  landSelection String // "entire" | "input"
  landSize      Float?
  landUnit      String   @default("acres")
  status        String   @default("Active") // Active | Complete | Planned
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  crops Crop[]

  @@index([farmId])
}

model Crop {
  id                  String    @id @default(cuid())
  cycleId             String
  cycle               CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  farmId              String
  cropName            String
  category            String?
  variety             String?
  areaSize            Float
  areaUnit            String    @default("acres")
  plantingDate        String
  expectedHarvestDate String
  status              String    @default("Active") // Active | Complete
  progress            Int       @default(0)
  currentActivity     String?
  icon                String?
  color               String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  soilPrepRecords       SoilPrepRecord[]
  tillageRecords        TillageRecord[]
  plantingRecords       PlantingRecord[]
  soilDataRecords       SoilDataRecord[]
  fieldConditionRecords FieldConditionRecord[]
  weatherDataRecords    WeatherDataRecord[]
  fertilizerRecords     FertilizerRecord[]
  irrigationRecords     IrrigationRecord[]
  weedingRecords        WeedingRecord[]
  chemicalRecords       ChemicalRecord[]
  diseaseRecords        DiseaseRecord[]
  pestRecords           PestRecord[]
  harvestingRecords     HarvestingRecord[]
  processingRecords     ProcessingRecord[]
  lossRecords           LossRecord[]
  saleRecords           CropSaleRecord[]
  alerts                CropAlert[]

  @@index([cycleId])
  @@index([farmId])
}

// ─── Phase 2: Soil Prep, Tillage, Planting ───────────────────────────────────

model SoilPrepRecord {
  id          String   @id @default(cuid())
  cropId      String
  crop        Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId      String
  date        DateTime
  tillageType String
  area        Float
  areaUnit    String   @default("acres")
  labourType  String?
  labourCost  Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model TillageRecord {
  id        String   @id @default(cuid())
  cropId    String
  crop      Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId    String
  date      DateTime
  system    String
  type      String
  equipment String?
  area      Float
  areaUnit  String   @default("acres")
  cost      Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model PlantingRecord {
  id              String   @id @default(cuid())
  cropId          String
  crop            Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId          String
  date            DateTime
  method          String
  seedName        String?
  seedQuantity    Float?
  seedUnit        String?
  labourType      String?
  numberOfWorkers Int?
  labourCost      Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

// ─── Soil Data Collection ────────────────────────────────────────────────────

model SoilDataRecord {
  id              String   @id @default(cuid())
  cropId          String
  crop            Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId          String
  date            DateTime
  soilType        String // sandy | loamy | clay
  soilTypeNote    String?
  soilPH          String // acid | neutral | alkaline
  soilPHNote      String?
  moistureContent String // dry | moist | wet
  moistureNote    String?
  organicMatter   String // low | medium | high
  organicNote     String?
  nitrogen        Boolean  @default(false)
  phosphorus      Boolean  @default(false)
  potassium       Boolean  @default(false)
  nutrientsNote   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model FieldConditionRecord {
  id                  String   @id @default(cuid())
  cropId              String
  crop                Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId              String
  date                DateTime
  topography          String // flat | sloped | hilly
  topographyNote      String?
  drainage            String // well-drained | poorly-drained | waterlogged
  drainageNote        String?
  previousCropResidue String // low | medium | high
  residueNote         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model WeatherDataRecord {
  id                 String   @id @default(cuid())
  cropId             String
  crop               Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId             String
  date               DateTime
  temperatureType    String // current | historical | forecasted
  temperatureValue   Float
  temperatureNote    String?
  precipitationType  String // rainfall-amount | rainfall-pattern | forecasted-precipitation
  precipitationValue Float
  precipitationNote  String?
  windType           String // current-wind | historical-wind | forecasted-wind
  windValue          Float
  windNote           String?
  humidityType       String // current-humidity | historical-humidity | forecasted-humidity
  humidityValue      Float
  humidityNote       String?
  locationName       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

// ─── Phase 3: Fertilizers, Irrigation, Weeding, Chemicals ──────────────────

model FertilizerRecord {
  id                String    @id @default(cuid())
  cropId            String
  crop              Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId            String
  date              DateTime
  fertilizerType    String // organic | inorganic
  fertilizerSource  String?
  mode              String // basal | top-dressing | foliar | fertigation
  applicationDate   DateTime?
  applicationMethod String?
  applicationTiming String?
  dosage            Float?
  dosageUnit        String    @default("kg")
  coverage          Float?
  coverageUnit      String    @default("acres")
  equipment         String?
  labourType        String?
  numberOfWorkers   Int?
  labourCost        Float?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model IrrigationRecord {
  id                String   @id @default(cuid())
  cropId            String
  crop              Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId            String
  date              DateTime
  method            String // drip | sprinkler | flood | furrow | etc
  soilMoisture      String?
  waterSource       String?
  volume            Float?
  volumeUnit        String   @default("liters")
  applicationMethod String?
  systemCost        Float?
  fuelCost          Float?
  labourType        String?
  numberOfWorkers   Int?
  labourCost        Float?
  hoursWorked       Float?
  additionalCharges Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model WeedingRecord {
  id                String   @id @default(cuid())
  cropId            String
  crop              Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId            String
  date              DateTime
  weedingType       String // manual | mechanical | chemical
  herbicideName     String?
  dosage            Float?
  dosageUnit        String   @default("liters")
  applicationMethod String?
  labourType        String?
  numberOfWorkers   Int?
  labourCost        Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model ChemicalRecord {
  id                String   @id @default(cuid())
  cropId            String
  crop              Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId            String
  date              DateTime
  chemicalName      String
