// ─── Phase 4: Diseases, Pests, Harvesting, Processing ──────────────────────

model DiseaseRecord {
  id              String    @id @default(cuid())
  cropId          String
  crop            Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId          String
  date            DateTime
  diseaseName     String
  methodOfControl String // physical | mechanical | chemical
  dateOfControl   DateTime?
  methodDetail    String?
  labourType      String?
  numberOfWorkers Int?
  labourCost      Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model PestRecord {
  id              String    @id @default(cuid())
  cropId          String
  crop            Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId          String
  date            DateTime
  pestName        String
  methodOfControl String
  dateOfControl   DateTime?
  methodDetail    String?
  labourType      String?
  numberOfWorkers Int?
  labourCost      Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model HarvestingRecord {
  id                    String   @id @default(cuid())
  cropId                String
  crop                  Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId                String
  date                  DateTime
  methodOfHarvesting    String // machine | human | animal
  typeOfMachine         String?
  fuelCost              Float?
  sourceMachine         String?
  operatorType          String?
  sourceLabor           String?
  workerName            String?
  timeWorked            Float?
  harvestedQuantity     Float?
  harvestedQuantityUnit String   @default("kg")
  harvestedQuality      String?
  meansOfTransport      String?
  numberOfTrips         Int?
  costOfTransport       Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model ProcessingRecord {
  id                 String   @id @default(cuid())
  cropId             String
  crop               Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId             String
  date               DateTime
  processingType     String
  processingMethod   String?
  equipment          String?
  labourType         String?
  numberOfWorkers    Int?
  labourCost         Float?
  outputQuantity     Float?
  outputQuantityUnit String   @default("kg")
  outputQuality      String?

  // Pest Control Fields (Step 2)
  dateOfPestControl   DateTime?
  pestIdentified      String?
  methodOfControl     String?
  pesticideSource     String?
  brandName           String?
  methodOfApplication String?
  amountAppliedPest   String?
  serialNumber        String?
  dateOfPurchase      DateTime?
  seller              String?
  quantityPurchased   String?
  purchasePrice       Float?
  transportCost       Float?

  // Storage Fields (Step 3)
  dateOfStorage              DateTime?
  finalQuantity              Float?
  finalQuality               String?
  typeOfStorage              String?
  miscellaneousCostsIncurred Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

// ─── Phase 5: Losses, Crop Sales, Crop Alerts ────────────────────────────

model LossRecord {
  id           String   @id @default(cuid())
  cropId       String
  crop         Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId       String
  date         DateTime
  lossType     String
  quantity     Float?
  quantityUnit String   @default("kg")
  cause        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model CropSaleRecord {
  id            String   @id @default(cuid())
  cropId        String
  crop          Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId        String
  date          DateTime
  quantity      Float
  quantityUnit  String   @default("kg")
  pricePerUnit  Float
  totalAmount   Float // computed: quantity * pricePerUnit
  buyerName     String?
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}

model CropAlert {
  id        String   @id @default(cuid())
  cropId    String
  crop      Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  farmId    String
  alertType String
  message   String
  severity  String   @default("info") // info | warning | critical
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cropId])
  @@index([farmId])
}
