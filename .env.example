# Core runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xpertfarmer?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=9003
NODE_ENV=production

# Onfon SMS. Billing messages are non-flash by default.
ONFON_API_KEY=""
ONFON_CLIENT_ID=""
ONFON_SENDER_ID=""
ONFON_IS_FLASH=false

# First-admin bootstrap. Use once through POST /auth/admins, then rotate/remove.
ADMIN_BOOTSTRAP_TOKEN="replace-with-a-long-one-time-secret"

# Safaricom Daraja / M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_C2B_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_C2B_RESPONSE_TYPE=Completed
# Must be public HTTPS in production. Daraja posts payment results here.
MPESA_CALLBACK_BASE_URL="https://api.xpertfarmer.com"
